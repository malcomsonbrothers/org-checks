#!/usr/bin/env bash
# >>> org-checks pre-push guards >>>
# Added by org-checks scripts/install-hooks.sh; re-run it to update .githooks/org/.
org_refs=$(mktemp) || exit 1
cat > "$org_refs"
bash "$(git rev-parse --show-toplevel)/.githooks/org/pre-push-guards.sh" "$@" < "$org_refs" || { rm -f "$org_refs"; exit 1; }
exec < "$org_refs"
rm -f "$org_refs"
# <<< org-checks pre-push guards <<<
# Checks what each pushed ref carries: files changed since the remote commit (or, for a
# new branch, since its merge-base with the default branch), read at the pushed commit.
set -euo pipefail
check="$(git rev-parse --show-toplevel)/scripts/check-file-lengths.sh"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  case $local_sha in *[!0]*) ;; *) continue ;; esac # deleting a remote ref sends no files
  "$check" --range "$remote_sha" "$local_sha" || status=1
done
exit "$status"
